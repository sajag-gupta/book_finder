{
  "name": "book-finder",
  "version": "0.1.0",
  "description": "Mood-first book finder that shows every way to buy, borrow or listen to a book.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Sajag Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajag-gupta/book_finder.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "setup": "node scripts/setup.mjs",
    "serve": "node scripts/dev-server.mjs",
    "start": "npm run build -- --skip-share-cards && node scripts/dev-server.mjs",
    "seo": "node scripts/seo-audit.js",
    "covers": "node --env-file-if-exists=.env scripts/build-covers.js",
    "build:preview": "node scripts/build.js --include-drafts",
    "dev": "npm run build:preview && wrangler pages dev dist",
    "validate": "node scripts/validate-data.js",
    "indexnow": "node --env-file-if-exists=.env scripts/indexnow.js",
    "discover": "node --env-file-if-exists=.env scripts/discover-popular.js",
    "enrich": "node --env-file-if-exists=.env scripts/enrich-hardcover.js",
    "trending": "node --env-file-if-exists=.env scripts/refresh-trending.js",
    "catalogue:isbns": "node --env-file-if-exists=.env scripts/resolve-isbns.js",
    "catalogue:index": "node scripts/catalogue-index.js",
    "email": "node --env-file-if-exists=.env scripts/email.js",
    "review": "node --env-file-if-exists=.env scripts/review.js",
    "verify:isbns": "node --env-file-if-exists=.env scripts/verify-isbns.js",
    "db:migrate:local": "wrangler d1 migrations apply book-finder --local",
    "db:migrate:remote": "wrangler d1 migrations apply book-finder --remote",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm run validate && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@playwright/cli": "^0.1.22",
    "@resvg/resvg-wasm": "^2.6.2",
    "ajv": "^8.17.0",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "lucide-static": "^1.58.0",
    "prettier": "^3.3.0",
    "satori": "^0.62.0",
    "wrangler": "^4.0.0"
  }
}

    "affiliate": {
      "template": "https://www.amazon.com/s?k={isbn13}&i=stripbooks&tag={amazon_tag}",
      "requires": ["amazon_tag"]
    },
    "commissionRate": 0.045,
    "cookieDays": 1
  },
  {
    "id": "kobo",
    "name": "Kobo",
    "kind": "ebook",
    "label": "Buy ebook",
    "plain": "https://www.kobo.com/us/en/search?query={query}",
    "affiliate": {
      "template": "https://click.linksynergy.com/deeplink?id={kobo_partner_id}&mid={kobo_merchant_id}&murl={plain_encoded}",

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https://covers.openlibrary.org https://archive.org https://*.archive.org https://*.impactradius-event.com data:; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'sha256-SWKcwEUphTEdMs+QEXUUa7+IpX162pac8KMZsXPtGkg=' https://utt.impactcdn.com; connect-src 'self' https://*.impactradius-event.com https://*.impactcdn.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

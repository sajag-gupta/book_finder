# Copy to .env and fill in. This file is safe to commit: it contains no values.
# Affiliate IDs are NOT secret and live in config/affiliates.json instead.

# Cloudflare (deploy + D1). Token needs: Pages Edit, D1 Edit, Workers Scripts Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Only needed if you do not use `gh auth login`.
GITHUB_TOKEN=

# Data sources (used by scripts/, never by the deployed site)
OL_CONTACT=
HARDCOVER_TOKEN=
GOOGLE_BOOKS_KEY=

# Weekly newsletter provider: buttondown | beehiiv | mailerlite
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Public site URL used for canonical links and the sitemap (no trailing slash)
SITE_URL=
